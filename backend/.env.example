PORT=3000

# Add /argumento (or your db name) before the ? in the URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/argumento?appName=YOUR_APP

JWT_SECRET=your_super_secret_key_here

# Optional - leave blank if not using AI features
GEMINI_AI_API=

# Optional - leave blank if not sending emails
GMAIL_USER=
GMAIL_APP_PASS=

CORS_ORIGIN=*
CRON_SECRET=
